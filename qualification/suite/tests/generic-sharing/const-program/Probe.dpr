program Probe;
{$mode objfpc}{$H+}
type TBit=(One,Two);TBits=set of TBit;
generic TBool<const N:Boolean>=class class function Value:Boolean;static;end;
generic TInt<const N:Int64>=class class function Value:Int64;static;end;
generic TQWord<const N:QWord>=class class function Value:QWord;static;end;
generic TWideInt<const N:UInt128>=class class function Value:UInt128;static;end;
generic TEnum<const N:TBit>=class class function Value:TBit;static;end;
generic TChar<const N:Char>=class class function Value:Char;static;end;
generic TText<const N:AnsiString>=class class function Value:AnsiString;static;end;
generic TUnicode<const N:UnicodeString>=class class function Value:UnicodeString;static;end;
generic TFloat<const N:Double>=class class function Value:Double;static;end;
generic TFloatClose<const N:Double>=class class function Value:Double;static;end;
generic TSet<const N:TBits>=class class function Value:TBits;static;end;
generic TNil<const N:Pointer>=class class function Value:Pointer;static;end;
generic TZero<const N:Double>=class class function Value:Double;static;end;
class function TBool.Value:Boolean;begin Result:=N;end;
class function TInt.Value:Int64;begin Result:=N;end;
class function TQWord.Value:QWord;begin Result:=N;end;
class function TWideInt.Value:UInt128;begin Result:=N;end;
class function TEnum.Value:TBit;begin Result:=N;end;
class function TChar.Value:Char;begin Result:=N;end;
class function TText.Value:AnsiString;begin Result:=N;end;
class function TUnicode.Value:UnicodeString;begin Result:=N;end;
class function TFloat.Value:Double;begin Result:=N;end;
class function TFloatClose.Value:Double;begin Result:=N;end;
class function TSet.Value:TBits;begin Result:=N;end;
class function TNil.Value:Pointer;begin Result:=N;end;
class function TZero.Value:Double;begin Result:=N;end;
type
Bool1=specialize TBool<True>;
Bool2=specialize TBool<False>;
Bool3=specialize TBool<True>;
Int1=specialize TInt<-1>;
Int2=specialize TInt<1>;
Int3=specialize TInt<-1>;
QWord1=specialize TQWord<18446744073709551615>;
QWord2=specialize TQWord<1>;
QWord3=specialize TQWord<18446744073709551615>;
WideInt1=specialize TWideInt<(UInt128(1) shl 64)>;
WideInt2=specialize TWideInt<(UInt128(2) shl 64)>;
WideInt3=specialize TWideInt<(UInt128(1) shl 64)>;
Enum1=specialize TEnum<One>;
Enum2=specialize TEnum<Two>;
Enum3=specialize TEnum<One>;
Char1=specialize TChar<'a'>;
Char2=specialize TChar<'b'>;
Char3=specialize TChar<'a'>;
Text1=specialize TText<'abc'>;
Text2=specialize TText<'abd'>;
Text3=specialize TText<'abc'>;
Unicode1=specialize TUnicode<#1046#1046>;
Unicode2=specialize TUnicode<#1071#1071>;
Unicode3=specialize TUnicode<#1046#1046>;
Float1=specialize TFloat<1.25>;
Float2=specialize TFloat<2.5>;
Float3=specialize TFloat<1.25>;
FloatClose1=specialize TFloatClose<1.0>;
FloatClose2=specialize TFloatClose<1.0000000000000002>;
FloatClose3=specialize TFloatClose<1.0>;
Set1=specialize TSet<[One]>;
Set2=specialize TSet<[Two]>;
Set3=specialize TSet<[One]>;
Nil1=specialize TNil<nil>;
Nil2=specialize TNil<nil>;
Nil3=specialize TNil<nil>;
Zero1=specialize TZero<0.0>;
Zero2=specialize TZero<-0.0>;
Zero3=specialize TZero<0.0>;
begin
Writeln('Bool_DISTINCT=',TClass(Bool1)<>TClass(Bool2));
Writeln('Bool_SAME=',TClass(Bool1)=TClass(Bool3));
Writeln('Bool_VALUES=',Ord(Bool1.Value),'/',Ord(Bool2.Value),'/',Ord(Bool3.Value));
Writeln('Int_DISTINCT=',TClass(Int1)<>TClass(Int2));
Writeln('Int_SAME=',TClass(Int1)=TClass(Int3));
Writeln('Int_VALUES=',Int1.Value,'/',Int2.Value,'/',Int3.Value);
Writeln('QWord_DISTINCT=',TClass(QWord1)<>TClass(QWord2));
Writeln('QWord_SAME=',TClass(QWord1)=TClass(QWord3));
Writeln('QWord_VALUES=',QWord1.Value,'/',QWord2.Value,'/',QWord3.Value);
Writeln('WideInt_DISTINCT=',TClass(WideInt1)<>TClass(WideInt2));
Writeln('WideInt_SAME=',TClass(WideInt1)=TClass(WideInt3));
Writeln('WideInt_VALUES=',Ord(WideInt1.Value=(UInt128(1) shl 64)),'/',Ord(WideInt2.Value=(UInt128(1) shl 64)),'/',Ord(WideInt3.Value=(UInt128(1) shl 64)));
Writeln('Enum_DISTINCT=',TClass(Enum1)<>TClass(Enum2));
Writeln('Enum_SAME=',TClass(Enum1)=TClass(Enum3));
Writeln('Enum_VALUES=',Ord(Enum1.Value),'/',Ord(Enum2.Value),'/',Ord(Enum3.Value));
Writeln('Char_DISTINCT=',TClass(Char1)<>TClass(Char2));
Writeln('Char_SAME=',TClass(Char1)=TClass(Char3));
Writeln('Char_VALUES=',Ord(Char1.Value),'/',Ord(Char2.Value),'/',Ord(Char3.Value));
Writeln('Text_DISTINCT=',TClass(Text1)<>TClass(Text2));
Writeln('Text_SAME=',TClass(Text1)=TClass(Text3));
Writeln('Text_VALUES=',Text1.Value,'/',Text2.Value,'/',Text3.Value);
Writeln('Unicode_DISTINCT=',TClass(Unicode1)<>TClass(Unicode2));
Writeln('Unicode_SAME=',TClass(Unicode1)=TClass(Unicode3));
Writeln('Unicode_VALUES=',Ord(Unicode1.Value[1]),'/',Ord(Unicode2.Value[1]),'/',Ord(Unicode3.Value[1]));
Writeln('Float_DISTINCT=',TClass(Float1)<>TClass(Float2));
Writeln('Float_SAME=',TClass(Float1)=TClass(Float3));
Writeln('Float_VALUES=',Float1.Value:0:2,'/',Float2.Value:0:2,'/',Float3.Value:0:2);
Writeln('FloatClose_DISTINCT=',TClass(FloatClose1)<>TClass(FloatClose2));
Writeln('FloatClose_SAME=',TClass(FloatClose1)=TClass(FloatClose3));
Writeln('FloatClose_VALUES=',Ord(FloatClose1.Value=1.0),'/',Ord(FloatClose2.Value=1.0),'/',Ord(FloatClose3.Value=1.0));
Writeln('Set_DISTINCT=',TClass(Set1)<>TClass(Set2));
Writeln('Set_SAME=',TClass(Set1)=TClass(Set3));
Writeln('Set_VALUES=',Ord(One in Set1.Value),'/',Ord(One in Set2.Value),'/',Ord(One in Set3.Value));
Writeln('Nil_DISTINCT=',TClass(Nil1)<>TClass(Nil2));
Writeln('Nil_SAME=',TClass(Nil1)=TClass(Nil3));
Writeln('Nil_VALUES=',Ord(Nil1.Value=nil),'/',Ord(Nil2.Value=nil),'/',Ord(Nil3.Value=nil));
Writeln('Zero_DISTINCT=',TClass(Zero1)<>TClass(Zero2));
Writeln('Zero_SAME=',TClass(Zero1)=TClass(Zero3));
Writeln('Zero_VALUES=',Ord(Zero1.Value=0.0),'/',Ord(Zero2.Value=0.0),'/',Ord(Zero3.Value=0.0));
Writeln('UNICODE_FULL_DISTINCT=',Unicode1.Value<>Unicode2.Value);
Writeln('UNICODE_FULL_SAME=',Unicode1.Value=Unicode3.Value);
end.