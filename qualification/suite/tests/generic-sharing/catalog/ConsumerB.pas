unit ConsumerB;
interface
uses System.SysUtils, System.TypInfo, GenericCore;
type TPublicAlias = TBox<Integer>;
function BoxClass: TClass;
function DerivedClass: TClass;
function AliasClass: TClass;
function DistinctClass: TClass;
function PrivateClass: TClass;
function BoxInfo: Pointer;
function PairInfo: Pointer;
function ReverseInfo: Pointer;
procedure SetCounter(N: Integer);
function GetCounter: Integer;
function StringRoundTrip: UnicodeString;
function PairRoundTrip: UnicodeString;
function NewBox: TObject;
function CheckBox(O: TObject): Boolean;
function NewInterface: IProbe;
function ReadInterface(const I: IProbe): Integer;
implementation
type TLocal = type Integer;
function BoxClass: TClass;
begin Result := TBox<Integer>; end;
function DerivedClass: TClass;
begin Result := TDerived<Integer>; end;
function AliasClass: TClass;
begin Result := TBox<TIntAlias>; end;
function DistinctClass: TClass;
begin Result := TBox<TIntDistinct>; end;
function PrivateClass: TClass;
begin Result := TBox<TLocal>; end;
function BoxInfo: Pointer;
begin Result := TypeInfo(TBox<Integer>); end;
function PairInfo: Pointer;
begin Result := TypeInfo(TPair<UnicodeString,Integer>); end;
function ReverseInfo: Pointer;
begin Result := TypeInfo(TPair<Integer,UnicodeString>); end;
procedure SetCounter(N: Integer);
begin TBox<Integer>.Counter := N; end;
function GetCounter: Integer;
begin Result := TBox<Integer>.Counter; end;
function StringRoundTrip: UnicodeString;
var O: TBox<UnicodeString>;
begin
  O := TBox<UnicodeString>.Create;
  try Result := O.Echo('hello '#$0416#$D83D#$DE00); finally O.Free; end;
end;
function PairRoundTrip: UnicodeString;
var R: TPair<UnicodeString,Integer>;
begin R.First := 'pair'; R.Second := 3; Result := R.CopyFirst; end;
function NewBox: TObject;
begin Result := TBox<Integer>.Create; end;
function CheckBox(O: TObject): Boolean;
begin Result := (O is TBox<Integer>) and (TBox<Integer>(O).Plus(5) = 12); end;
function NewInterface: IProbe;
begin Result := TAdapter<Integer>.Create; end;
function ReadInterface(const I: IProbe): Integer;
begin Result := I.ReadValue; end;
end.
