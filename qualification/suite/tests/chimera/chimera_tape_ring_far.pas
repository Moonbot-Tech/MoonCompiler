unit chimera_tape_ring_far;

{ Те же чистые шаги — но из юнита, затянутого в КОЛЬЦО зависимостей вместе со
  своим вызывателем.

  Кольцо замыкается с `chimera_tape_v4`: тот называет этот юнит в своём
  ЗАГОЛОВКЕ, а этот зовёт его из своей РЕАЛИЗАЦИИ. Связка законная и в живом
  коде встречается на каждом шагу — так устроена пара «рынок и движок» в
  MoonBot, и автор там прямо пишет, что вставка ИЗНУТРИ кольца мертва.

  Уточнение, добытое опытом на этом же компиляторе: мертва она не для всякого,
  кто зовёт функцию из юнита в кольце, а только для того, кто зовёт её,
  находясь в том же кольце. Снаружи кольца тело уже скомпилировано и
  вставляется как обычно. Поэтому вызыватель и заведён внутри кольца — иначе
  ось «вставлено против невставлено» была бы фикцией.

  Текст шагов подключается тем же файлом, что и в листовом юните, поэтому он
  совпадает до буквы. Вся разница — положение юнита в графе. }

{$ifdef FPC}
  {$mode delphiunicode}{$H+}
  {$modeswitch advancedrecords}
  {$modeswitch INLINEVARS}
{$endif}
{$Q-}{$R-}

interface

uses
  SysUtils, chimera_body, chimera_tape_types;

{$I chimera_tape_steps.decl.inc}

{ Работа, ради которой юнит и лезет к соседу из реализации: этим кольцо и
  замыкается. }
function XRingProbe(N: Integer): Integer;

implementation

uses
  chimera_tape_v4;

{$I chimera_tape_steps.impl.inc}

function XRingProbe(N: Integer): Integer;
begin
  Result := ChiTapeV4Stamp(N);
end;

end.
