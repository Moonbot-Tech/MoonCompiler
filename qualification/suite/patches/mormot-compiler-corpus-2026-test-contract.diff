+type
+  /// counts the read requests the server accepted: a client resends a request
+  // whose answer is late, and the server serves the resend as one more connection
+  TTftpCountingServer = class(TTftpServerThread)
+  protected
+    fAccepted: integer;
+    function SetRrqStream(var Context: TTftpContext): TTftpError; override;
+  end;
+
+function TTftpCountingServer.SetRrqStream(var Context: TTftpContext): TTftpError;
+begin
+  result := inherited SetRrqStream(Context);
+  if result = teNoError then
+    inc(fAccepted);
+end;
+
 procedure TNetworkProtocols.TFTPServer;
 var
-  srv: TTftpServerThread;
+  srv: TTftpCountingServer;
   http: THttpServer;
   res: TCurlResult;
   fn: TFileName;
