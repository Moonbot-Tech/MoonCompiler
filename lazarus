#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "$0")" && pwd)
IDE_TOOLCHAIN="$ROOT/toolchain/ide"
IDE_FPC="$IDE_TOOLCHAIN/bin/fpc"
LAZARUS_SOURCE="$ROOT/lazarus-src"
LAZARUS_EXE="$LAZARUS_SOURCE/lazarus"
PRIMARY_CONFIG="$ROOT/lazarus-config"

[[ -x "$IDE_FPC" ]] || "$ROOT/build" compiler
[[ -x "$LAZARUS_EXE" ]] || "$ROOT/build" lazarus

export PATH="$IDE_TOOLCHAIN/bin:$PATH"
export PP="$IDE_FPC"
export PPC_CONFIG_PATH="$IDE_TOOLCHAIN/etc"
export LAZARUSDIR="$LAZARUS_SOURCE"
unset FPCDIR
exec "$LAZARUS_EXE" "--pcp=$PRIMARY_CONFIG" "$@"
