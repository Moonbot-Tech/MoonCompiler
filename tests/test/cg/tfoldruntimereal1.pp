{ min/max over memory: the rewrite into minsd/maxsd against the same choice
  made through a Boolean the rewrite does not see }
function MinScan(const A: array of Double): Double; {$ifdef FPC}noinline;{$endif}
var
  I: Integer;
  M: Double;
begin
  M := A[0];
  for I := 1 to High(A) do
    If A[I] < M then
      M := A[I];
  Result := M;
end;

function MinScanRef(const A: array of Double): Double; {$ifdef FPC}noinline;{$endif}
var
  I: Integer;
  M: Double;
  Take: Boolean;
begin
  M := A[0];
  for I := 1 to High(A) do
  begin
    Take := A[I] < M;
    If Take then
      M := A[I];
  end;
  Result := M;
end;

function MaxScan(const A: array of Double): Double; {$ifdef FPC}noinline;{$endif}
var
  I: Integer;
  M: Double;
begin
  M := A[0];
  for I := 1 to High(A) do
    If A[I] > M then
      M := A[I];
  Result := M;
end;

function MaxScanRef(const A: array of Double): Double; {$ifdef FPC}noinline;{$endif}
var
  I: Integer;
  M: Double;
  Take: Boolean;
begin
  M := A[0];
  for I := 1 to High(A) do
  begin
    Take := A[I] > M;
    If Take then
      M := A[I];
  end;
  Result := M;
end;

procedure Widen(P: PRange; V: Double); {$ifdef FPC}noinline;{$endif}
begin
  If V < P^.Lo then
    P^.Lo := V;
  If V > P^.Hi then
    P^.Hi := V;
end;

procedure WidenRef(P: PRange; V: Double); {$ifdef FPC}noinline;{$endif}
var
  Take: Boolean;
begin
  Take := V < P^.Lo;
  If Take then
    P^.Lo := V;
  Take := V > P^.Hi;
  If Take then
    P^.Hi := V;
end;

procedure LowerElement(var A: array of Double; I: Integer; V: Double); {$ifdef FPC}noinline;{$endif}
begin
  If V < A[I] then
    A[I] := V;
end;

procedure LowerElementRef(var A: array of Double; I: Integer; V: Double); {$ifdef FPC}noinline;{$endif}
var
  Take: Boolean;
begin
  Take := V < A[I];
  If Take then
    A[I] := V;
end;

procedure CheckMemoryMinMax;
var
  Values: array[0..4] of Double;
  A: array[0..2] of Double;
  B: array[0..2] of Double;
  R, RR: TRange;
  I, J, K, Code: Integer;
begin
  Values[0] := 0.0;
  Values[1] := -0.0;
  Values[2] := NaN;
  Values[3] := 1.0;
  Values[4] := -1.0;
  Code := 900000;
  for I := 0 to 4 do
    for J := 0 to 4 do
      for K := 0 to 4 do
      begin
        A[0] := Values[I];
        A[1] := Values[J];
        A[2] := Values[K];
        CD(Code, MinScan(A), MinScanRef(A));
        CD(Code + 1, MaxScan(A), MaxScanRef(A));
        R.Lo := Values[I];
        R.Hi := Values[J];
        RR := R;
        Widen(@R, Values[K]);
        WidenRef(@RR, Values[K]);
        CD(Code + 2, R.Lo, RR.Lo);
        CD(Code + 3, R.Hi, RR.Hi);
        A[0] := Values[I];
        A[1] := Values[J];
        B[0] := Values[I];
        B[1] := Values[J];
        LowerElement(A, 1, Values[K]);
        LowerElementRef(B, 1, Values[K]);
        CD(Code + 4, A[1], B[1]);
        Inc(Code, 10);
      end;
end;

{ An exceptional operand or result keeps the operation at run time: with the
  exception unmasked, the inlined constant operation still raises it. }
var
  Sink: Double;
  SinkS: Single;
  SinkI: Int64;
  SinkB: Boolean;

procedure ExpectTrap(Code: Integer);
var
  Mask: {$ifdef FPC}TFPUExceptionMask{$else}TArithmeticExceptionMask{$endif};
begin
  Mask := GetExceptionMask;
  If Code < 10 then
    SetExceptionMask([exDenormalized, exUnderflow, exPrecision])
  else
    SetExceptionMask([exDenormalized, exPrecision]);
  try
    try
      case Code of
        0: Sink := DivD(1.0, 0.0);
        1: Sink := DivD(0.0, 0.0);
        2: Sink := MulD(1.7976931348623157e308, 2.0);
        3: Sink := SqrtD(-1.0);
        4: Sink := AddD(Infinity, NegInfinity);
        5: Sink := MulD(0.0, Infinity);
        6: SinkS := DToS(1.0e300);
        7: SinkI := TruncD(1.0e30);
        8: SinkB := LtD(NaN, 1.0);
        9: SinkS := MulS(3.0e38, 3.0e38);
        { the exact result lies below the smallest normal number and rounds up
          to it: tiny after rounding with unbounded exponent }
        10: Sink := MulD(4.4501477170144023e-308, 0.5);
        11: Sink := DivD(4.4501477170144023e-308, 2.0);
        12: SinkS := DToS(1.1754942807573643e-38);
        13: SinkS := MulS(2.3509885615147286e-38, 0.5);
      end;
      Fail('trap ' + IntToStr(Code) + ' not raised');
    except
      on EMathError do
        ;
    end;
  finally
    ClearExceptions(False);
    SetExceptionMask(Mask);
  end;
end;

var
  T: Integer;
begin
  Checks := 0;
  Failures := 0;
  RunPairsD;
  RunPairsS;
  CheckMemoryMinMax;
  for T := 0 to 13 do
    ExpectTrap(T);
  WriteLn('checks=', Checks, ' failures=', Failures);
  If Failures <> 0 then
    Halt(1);
  WriteLn('TFOLDRUNTIMEREAL1_PASS');
end.
