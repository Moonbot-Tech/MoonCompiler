{ %CPU=x86_64 }
{ %OPT=-O3 }
program tfoldruntimereal1;

{ A floating-point operation on constants met after inlining is a run-time
  operation.  Where the compiler folds it, the value is bit for bit the one the
  instruction computes at run time in the product FP state (round to nearest,
  exceptions masked); an operation with an exceptional operand or result stays
  at run time and traps once the program unmasks the exception.  A result that
  rounds up to the smallest normal number is tiny (x86 detects tininess after
  rounding) and underflows: it stays at run time too.

  Every inline helper is called with grid constants (folded where ordinary) and,
  inside a routine that is not inlined, with the same values as parameters
  (computed at run time); reals are compared by bits, NaN payload and the sign
  of zero included.  P1*P2 and 1+H are halfway cases: computed in the x87
  format and rounded to Double afterwards they come out one unit lower than
  the SSE instruction gives.  Min/max over an array element and over a field
  through a pointer (the rewrite into minsd/maxsd) is compared with a form the
  rewrite does not touch.  The same program compiles under Delphi 12.2.
  It sets no range or overflow switch: the real-folds gate also builds it
  with -Cr -Co, where the min/max over an element keeps its range check.

  Generated by lab/impl/real_numbers_after_inline/gen/gen_test.py (the
  generator wrote the Q- and R- switches, taken out here). }

{$ifdef FPC}
  {$mode delphi}
{$endif}
{$APPTYPE CONSOLE}

uses
  SysUtils, Math;

type
  TRange = record
    Lo, Hi: Double;
  end;
  PRange = ^TRange;

var
  Checks, Failures: Integer;

function DBits(X: Double): UInt64;
begin
  Move(X, Result, SizeOf(Result));
end;

function SBits(X: Single): Cardinal;
begin
  Move(X, Result, SizeOf(Result));
end;

procedure Fail(const What: string);
begin
  Inc(Failures);
  WriteLn('MISMATCH ', What);
end;

procedure CD(Code: Integer; Folded, Runtime: Double);
begin
  Inc(Checks);
  If DBits(Folded) <> DBits(Runtime) then
    Fail(IntToStr(Code) + ' folded=' + IntToHex(DBits(Folded), 16) + ' run-time=' + IntToHex(DBits(Runtime), 16));
end;

procedure CS(Code: Integer; Folded, Runtime: Single);
begin
  Inc(Checks);
  If SBits(Folded) <> SBits(Runtime) then
    Fail(IntToStr(Code) + ' folded=' + IntToHex(SBits(Folded), 8) + ' run-time=' + IntToHex(SBits(Runtime), 8));
end;

procedure CB(Code: Integer; Folded, Runtime: Boolean);
begin
  Inc(Checks);
  If Folded <> Runtime then
    Fail(IntToStr(Code) + ' folded=' + BoolToStr(Folded, True) + ' run-time=' + BoolToStr(Runtime, True));
end;

procedure CI(Code: Integer; Folded, Runtime: Int64);
begin
  Inc(Checks);
  If Folded <> Runtime then
    Fail(IntToStr(Code) + ' folded=' + IntToStr(Folded) + ' run-time=' + IntToStr(Runtime));
end;

function AddD(A, B: Double): Double; inline; begin Result := A + B; end;
function SubD(A, B: Double): Double; inline; begin Result := A - B; end;
function MulD(A, B: Double): Double; inline; begin Result := A * B; end;
function DivD(A, B: Double): Double; inline; begin Result := A / B; end;
function LtD(A, B: Double): Boolean; inline; begin Result := A < B; end;
function LeD(A, B: Double): Boolean; inline; begin Result := A <= B; end;
function GtD(A, B: Double): Boolean; inline; begin Result := A > B; end;
function GeD(A, B: Double): Boolean; inline; begin Result := A >= B; end;
function EqD(A, B: Double): Boolean; inline; begin Result := A = B; end;
function NeD(A, B: Double): Boolean; inline; begin Result := A <> B; end;
function MinD(A, B: Double): Double; inline; begin Result := Min(A, B); end;
function MaxD(A, B: Double): Double; inline; begin Result := Max(A, B); end;
function SqrD(A: Double): Double; inline; begin Result := Sqr(A); end;
function SqrtD(A: Double): Double; inline; begin Result := Sqrt(A); end;
function FracD(A: Double): Double; inline; begin Result := Frac(A); end;
function IntD(A: Double): Double; inline; begin Result := Int(A); end;
function ExpD(A: Double): Double; inline; begin Result := Exp(A); end;
function LnD(A: Double): Double; inline; begin Result := Ln(A); end;
function SinD(A: Double): Double; inline; begin Result := Sin(A); end;
function CosD(A: Double): Double; inline; begin Result := Cos(A); end;
function ArcTanD(A: Double): Double; inline; begin Result := ArcTan(A); end;
function AbsD(A: Double): Double; inline; begin Result := Abs(A); end;
function TruncD(A: Double): Int64; inline; begin Result := Trunc(A); end;
function DToS(A: Double): Single; inline; begin Result := A; end;

function AddS(A, B: Single): Single; inline; begin Result := A + B; end;
function SubS(A, B: Single): Single; inline; begin Result := A - B; end;
function MulS(A, B: Single): Single; inline; begin Result := A * B; end;
function DivS(A, B: Single): Single; inline; begin Result := A / B; end;
function LtS(A, B: Single): Boolean; inline; begin Result := A < B; end;
function EqS(A, B: Single): Boolean; inline; begin Result := A = B; end;
function MinS(A, B: Single): Single; inline; begin Result := Min(A, B); end;
function MaxS(A, B: Single): Single; inline; begin Result := Max(A, B); end;
function SqrS(A: Single): Single; inline; begin Result := Sqr(A); end;
function SqrtS(A: Single): Single; inline; begin Result := Sqrt(A); end;
function SToD(A: Single): Double; inline; begin Result := A; end;

procedure PairD(Code: Integer; A, B, FAdd, FSub, FMul, FDiv: Double;
  FLt, FLe, FGt, FGe, FEq, FNe: Boolean; FMin, FMax: Double); {$ifdef FPC}noinline;{$endif}
begin
  CD(Code + 0, FAdd, AddD(A, B));
  CD(Code + 1, FSub, SubD(A, B));
  CD(Code + 2, FMul, MulD(A, B));
  CD(Code + 3, FDiv, DivD(A, B));
  CB(Code + 4, FLt, LtD(A, B));
  CB(Code + 5, FLe, LeD(A, B));
  CB(Code + 6, FGt, GtD(A, B));
  CB(Code + 7, FGe, GeD(A, B));
  CB(Code + 8, FEq, EqD(A, B));
  CB(Code + 9, FNe, NeD(A, B));
  CD(Code + 10, FMin, MinD(A, B));
  CD(Code + 11, FMax, MaxD(A, B));
end;

procedure UnaryD(Code: Integer; A, FSqr, FSqrt, FFrac, FInt, FExp, FLn, FSin, FCos, FArcTan, FAbs: Double;
  FTrunc: Int64; FToS: Single); {$ifdef FPC}noinline;{$endif}
begin
  CD(Code + 0, FSqr, SqrD(A));
  CD(Code + 1, FSqrt, SqrtD(A));
  CD(Code + 2, FFrac, FracD(A));
  CD(Code + 3, FInt, IntD(A));
  CD(Code + 4, FExp, ExpD(A));
  CD(Code + 5, FLn, LnD(A));
  CD(Code + 6, FSin, SinD(A));
  CD(Code + 7, FCos, CosD(A));
  CD(Code + 8, FArcTan, ArcTanD(A));
  CD(Code + 9, FAbs, AbsD(A));
  { Trunc of a NaN, an infinity or a value outside Int64 is the integer
    indefinite at run time: compare only where it is defined }
  If not IsNan(A) and (Abs(A) < 9.2e18) then
    CI(Code + 10, FTrunc, TruncD(A));
  CS(Code + 11, FToS, DToS(A));
end;

procedure PairS(Code: Integer; A, B, FAdd, FSub, FMul, FDiv: Single; FLt, FEq: Boolean;
  FMin, FMax: Single); {$ifdef FPC}noinline;{$endif}
begin
  CS(Code + 0, FAdd, AddS(A, B));
  CS(Code + 1, FSub, SubS(A, B));
  CS(Code + 2, FMul, MulS(A, B));
  CS(Code + 3, FDiv, DivS(A, B));
  CB(Code + 4, FLt, LtS(A, B));
  CB(Code + 5, FEq, EqS(A, B));
  CS(Code + 6, FMin, MinS(A, B));
  CS(Code + 7, FMax, MaxS(A, B));
end;

procedure UnaryS(Code: Integer; A, FSqr, FSqrt: Single; FToD: Double); {$ifdef FPC}noinline;{$endif}
begin
  CS(Code + 0, FSqr, SqrS(A));
  CS(Code + 1, FSqrt, SqrtS(A));
  CD(Code + 2, FToD, SToD(A));
end;

