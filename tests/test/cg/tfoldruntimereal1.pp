  D05 = 0.1; { 0.1 }
  D06 = 3.0; { 3 }
  D07 = 1.7976931348623157e308; { MaxDouble }
  D08 = 2.2250738585072014e-308; { MinNormal }
  D09 = 4.9406564584124654e-324; { MinSubnormal }
  D10 = Infinity; { +Inf }
  D11 = NegInfinity; { -Inf }
  D12 = NaN; { NaN }
  D13 = 1.0977456781970063; { P1 }
  D14 = 1.4521756245746542; { P2 }
  D15 = 1.1102230328969627e-16; { H }
  S00 = Single(0.0); { +0 }
  S01 = Single(-0.0); { -0 }
  S02 = Single(1.0); { 1 }
  S03 = Single(-1.0); { -1 }
  S04 = Single(1.5); { 1.5 }
  S05 = Single(0.1); { 0.1 }
  S06 = Single(3.0); { 3 }
