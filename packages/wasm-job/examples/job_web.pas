procedure TJSGeolocation.getCurrentPosition(const aSuccessCallback: TPositionCallback; const aErrorCallback: TPositionErrorCallback; const aOptions: IJSPositionOptions);
var
  m: TJOB_Method;
  m2: TJOB_Method;
begin
  m:=TJOB_Method.Create(TMethod(aSuccessCallback),@JOBCallPositionCallback);
  m2:=TJOB_Method.Create(TMethod(aErrorCallback),@JOBCallPositionErrorCallback);
  try
    InvokeJSNoResult('getCurrentPosition',[m,m2,aOptions]);
  finally
    m.free;
